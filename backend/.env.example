# Supabase PostgreSQL
SUPABASE_DB_URL=jdbc:postgresql://<supabase-host>:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=replace-with-your-supabase-db-password

# Gmail SMTP for OTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-project-gmail
MAIL_PASSWORD=replace-with-gmail-app-password

# System-created administrator
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-admin-login-password
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=replace-with-admin-email
